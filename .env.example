# Copy to .env.local for a local shell. Never commit the copy.
# Use a different Supabase project and a different Anthropic key for
# local, staging, and production. Leave the production Vercel project's
# Preview environment empty: preview must not receive production secrets.
#
# APP_ENV is local, staging, or production. It is the name this deploy publishes.
# VERCEL_ENV is set by Vercel (production, preview, or development). Do not
# copy it from another project. A preview deploy with APP_ENV=production is refused.
APP_ENV=local

# https origin only. No path, query, user, or password.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key for THIS project. At least 20 characters. Not the service-role key.
SUPABASE_ANON_KEY=

# Server only. Must differ from the anon key. Never put this in a browser file.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. At least 16 characters. Mixed into IP hashes.
API_QUOTA_PEPPER=

# Server only. At least 20 characters.
ANTHROPIC_API_KEY=

# Browser error reports. Leave empty until you mean to enable them.
# The only value that turns them on is: on
CLIENT_ERROR_REPORTS=

# Staging Vercel project only, including that project's Preview environment.
# Set it to the same value as APP_ENV (staging). Do not set it on the
# production project. Production Preview must stay empty.
# ALLOW_PREVIEW_PUBLIC_CONFIG=staging
